# =============================================================================
# appardas · Discord Bot — environment template
# Copy to .env (local) or paste into the bot-hosting.net Env manager.
# Documentation: comments in this file
# =============================================================================

# -----------------------------------------------------------------------------
# DISCORD
# -----------------------------------------------------------------------------
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
BOT_OWNER_IDS=<YOUR_DISCORD_USER_ID>

# Set to a test server ID for instant command sync in development.
# Leave EMPTY in production (global sync, up to 1 h).
DISCORD_DEV_GUILD_ID=

COMMAND_SYNC_ON_START=true
ENABLE_MEMBER_INTENT=true
# Optional text prefixes: also enable Message Content Intent in the Discord portal.
# Keep false for slash commands + mention-only text commands.
ENABLE_MESSAGE_CONTENT_INTENT=false
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_TEXT=/appardas help

# -----------------------------------------------------------------------------
# HTTP & PUBLIC ORIGIN (the single port)
# -----------------------------------------------------------------------------
# MUST be 0.0.0.0 on the host. 127.0.0.1 is unreachable from outside the container.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# PORT is injected by the panel; do not set it manually.

# Required in production: canonical origin (e.g. https://appardas.example.com).
# In development, http://localhost:8080 is allowed.
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# SESSIONS & AUTH
# -----------------------------------------------------------------------------
# Console sign-in uses owner-assigned usernames and passwords, not Discord OAuth.
# Discord IDs associate accounts; DISCORD_CLIENT_ID/SECRET are not required.
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Set false ONLY in local development over http://. Must be true in production.
COOKIE_SECURE=true
# Set true ONLY behind a reverse proxy (e.g. Cloudflare) that overwrites X-Forwarded-For.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# APP-LEVEL RATE LIMITING & PROTECTION
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=20
MAX_CONNECTIONS=32
REQUEST_TIMEOUT_S=10

# -----------------------------------------------------------------------------
# GITHUB
# -----------------------------------------------------------------------------
# Fine-grained PAT, public repositories, read-only.
# Without it: 60 req/h. With it: 5000 req/h.
GITHUB_TOKEN=
GITHUB_POLL_INTERVAL_S=300
GITHUB_MAX_WATCHES=5
GITHUB_REQUEST_TIMEOUT_S=10

# -----------------------------------------------------------------------------
# STORAGE & LOGGING
# -----------------------------------------------------------------------------
DATABASE_PATH=data/appardas.db
LOG_DIR=data/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUPS=2

# -----------------------------------------------------------------------------
# BEHAVIOUR, GUARDRAILS & RETENTION
# -----------------------------------------------------------------------------
DEFAULT_TIMEZONE=UTC
NUDGE_ENABLED=true
NUDGE_PAIR_COOLDOWN_S=60
NUDGE_MAX_PER_HOUR=5
NUDGE_MAX_PER_TARGET_DAY=10
ANNOUNCE_MAX_PENDING=25
ANNOUNCE_MAX_PER_POLL=5
AUDIT_RETENTION_DAYS=90
ACTIVITY_RETENTION_DAYS=180
NUDGE_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
ENVIRONMENT=production
TZ=UTC
PYTHONUNBUFFERED=1
PYTHONOPTIMIZE=2
MALLOC_ARENA_MAX=2
